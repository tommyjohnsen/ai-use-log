{
  "fields": {
    "ts": {"type": "string", "required": true},
    "tool": {"type": "string", "required": true},
    "model_version": {"type": "string", "required": false},
    "task": {"type": "string", "required": true, "allowed": ["research", "outline", "edit", "cite-check", "code"]},
    "purpose": {"type": "string", "required": false},
    "output_use": {"type": "string", "required": false, "allowed": ["adopted", "modified", "rejected"]},
    "sections": {"type": "string", "required": false},
    "human_check": {"type": "string", "required": false},
    "approval_ref": {"type": "string", "required": false},
    "confidential_input": {"type": "boolean", "required": true, "default": false}
  },
  "allow_unknown_fields": false
}
